# Database
DATABASE_URL=postgresql://user:password@localhost:5432/pps_db

# NextAuth
NEXTAUTH_URL=http://localhost:2000
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXT_PUBLIC_APP_URL=http://localhost:2000

# Realtime (Ably)
ABLY_API_KEY=your_ably_api_key

# Live lessons (LiveKit)
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_URL=wss://your-livekit-server
NEXT_PUBLIC_LIVEKIT_URL=wss://your-livekit-server

# Mobile money payments (ZMW)
APP_URL=https://your-production-domain.example
BROADPAY_PUBLIC_KEY=
BROADPAY_SECRET_KEY=
DPO_COMPANY_TOKEN=
DPO_SERVICE_TYPE=
DPO_SERVICE_DESCRIPTION=PPS learning subscription
DPO_CHECKOUT_URL=
DPO_DEFAULT_PAYMENT_COUNTRY=
DPO_MTN_MNO=
DPO_AIRTEL_MNO=

# Cloudinary
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Brevo Email
BREVO_API_KEY=your_brevo_api_key
BREVO_FROM_EMAIL=noreply@yourdomain.com
BREVO_FROM_NAME="Progress Prep Schools"
