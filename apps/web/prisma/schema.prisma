generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
  engineType = "library"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Production-ready Prisma schema for PPS LMS (expanded for scalability)
// Includes soft-deletes, media assets, content revisioning, invoices, refunds,
// granular permissions, site settings, analytics, webhooks and integrations.

model User {
  id               String       @id @default(cuid())
  email            String       @unique
  password         String?
  phone            String?      @unique
  phoneVerified    Boolean      @default(false)
  emailVerified    DateTime?
  firstName        String
  lastName         String
  displayName      String?
  dateOfBirth      DateTime?
  gender           String?
  avatarId         String?
  avatar           MediaAsset?  @relation("UserAvatar", fields: [avatarId], references: [id])
  role             UserRole     @default(STUDENT)
  status           UserStatus   @default(ACTIVE)
  nationalId       String?      @unique
  idVerified       Boolean      @default(false)
  idVerifiedAt     DateTime?
  metadata         Json?
  isDeleted        Boolean      @default(false)
  deletedAt        DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  // Relations
  studentProfile   Student?  @relation("StudentUser")
  teacherProfile   Teacher?
  subscriptions    Subscription[]
  payments         Payment[]
  enrollments      Enrollment[]
  examAttempts     ExamAttempt[]
  progressRecords  Progress[]
  notifications    Notification[]
  sentMessages     Communication[] @relation("SentMessages")
  receivedMessages Communication[] @relation("ReceivedMessages")
  teachingClasses  TeacherClass[]
  auditLogs        AuditLog[]
  children         Student[] @relation("StudentParent")
  sessionAttendances SessionAttendee[]
  apiKeys          ApiKey[]
  invoices         Invoice[] @relation("UserInvoices")
  uploadedMedia    MediaAsset[] @relation("MediaAssetUploader")
  resources        Resource[] @relation("UserResources")
  contentRevisions ContentRevision[] @relation("UserContentRevisions")
  newsArticles     NewsArticle[] @relation("UserNewsArticles")
  chatMessages     ChatMessage[]
  studentActivities StudentActivity[]
  createdExercises ClassExercise[] @relation("ExerciseCreator")
  exerciseResponses ClassExerciseResponse[] @relation("ExerciseResponses")
  createdPolls     LivePoll[] @relation("PollCreator")
  pollResponses    LivePollResponse[] @relation("PollResponses")
}

enum UserRole {
  STUDENT
  PARENT
  TEACHER
  ADMIN
  FINANCE
  SUPPORT
  CONTENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

model Student {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation("StudentUser", fields: [userId], references: [id], onDelete: Cascade)
  grade      Int?
  cohort     String?
  schoolYear String?
  parentId   String?
  parent     User?    @relation("StudentParent", fields: [parentId], references: [id], onDelete: SetNull)
  isDeleted  Boolean  @default(false)
  deletedAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Teacher {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  qualifications    String?  // JSON or text
  yearsOfExperience Int?
  bio               String?
  specialties       String?  // JSON array
  hourlyRate        Float?
  publicProfile     Boolean  @default(true)
  isDeleted         Boolean  @default(false)
  deletedAt         DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Program {
  id          String        @id @default(cuid())
  name        String        @unique
  slug        String        @unique
  description String?
  type        ProgramType
  icon        String?
  metadata    Json?
  isDeleted   Boolean       @default(false)
  deletedAt   DateTime?
  createdAt   DateTime      @default(now())
  subscriptionPlans SubscriptionPlan[]
  classes     Class[]
}

model Subject {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String?  @unique
  metadata  Json?
  isDeleted Boolean  @default(false)
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ProgramType {
  ONLINE_FULL_TIME
  HOME_TUITION
  ON_CAMPUS
  HOLIDAY_TUITION
  RESOURCES_SHOP
}

model SubscriptionPlan {
  id           String   @id @default(cuid())
  programId    String
  program      Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  name         String
  slug         String?  @unique
  description  String?
  priceUsd     Float
  currency     String   @default("USD")
  durationDays Int
  billingCycle String?
  billingInterval SubscriptionBillingInterval @default(PER_MONTH)
  intervalCount Int      @default(1)
  targetType   SubscriptionTargetType @default(GENERAL)
  targetId     String?
  targetMetadata Json?
  subjectId    String?
  classId      String?
  lessonId     String?
  subjects     Json?
  grades       Json?
  metadata     Json?
  isDeleted    Boolean  @default(false)
  deletedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  subscriptions Subscription[]
}

model Subscription {
  id               String        @id @default(cuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId           String
  plan             SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  targetType       SubscriptionTargetType?
  targetId         String?
  targetMetadata   Json?
  subjectId        String?
  classId          String?
  lessonId         String?
  status           SubscriptionStatus @default(ACTIVE)
  startDate        DateTime      @default(now())
  endDate          DateTime?
  renewAt          DateTime?
  cancelledAt      DateTime?
  metadata         Json?
  invoices         Invoice[]
  payments         Payment[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  CANCELLED
  EXPIRED
  PAST_DUE
}

enum SubscriptionBillingInterval {
  PER_HOUR
  PER_DAY
  PER_WEEK
  PER_MONTH
  PER_YEAR
  PER_TERM
  PER_SEMESTER
  PER_SESSION
}

enum SubscriptionTargetType {
  GENERAL
  SUBJECT
  CLASS
  SESSION
  TERM
  SEMESTER
  CUSTOM
}

model Invoice {
  id             String   @id @default(cuid())
  invoiceNumber  String   @unique
  userId         String
  user           User     @relation("UserInvoices", fields: [userId], references: [id], onDelete: Cascade)
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  amount         Float
  currency       String   @default("USD")
  url            String?
  issuedAt       DateTime @default(now())
  dueAt          DateTime?
  paidAt         DateTime?
  status         PaymentStatus
  metadata       Json?
}

model Refund {
  id            String   @id @default(cuid())
  paymentId     String
  payment       Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  amount        Float
  reason        String?
  processedAt   DateTime?
  externalRef   String?
  status        RefundStatus @default(PENDING)
}

enum RefundStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Payment {
  id                    String   @id @default(cuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionId        String?
  subscription          Subscription? @relation(fields: [subscriptionId], references: [id])
  amount                Float
  currency              String   @default("USD")
  paymentMethod         PaymentMethod
  stripePaymentIntentId String?  @unique
  pesapalOrderId        String?  @unique
  transactionRef        String?  @unique
  status                PaymentStatus
  invoiceNumber         String?  @unique
  invoiceUrl            String?
  receiptUrl            String?
  failureReason         String?
  gatewayResponse       Json?
  retryCount            Int      @default(0)
  nextRetryAt           DateTime?
  refunded              Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  refunds               Refund[]
}

enum PaymentMethod {
  STRIPE
  PESAPAL
  BANK_TRANSFER
  MTN_MONEY
  AIRTEL_MONEY
  WALLET
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  REFUNDED
  DISPUTED
}

model Class {
  id          String   @id @default(cuid())
  programId   String
  program     Program  @relation(fields: [programId], references: [id])
  name        String
  grade       Int?
  subject     String?
  capacity    Int      @default(30)
  teachers    TeacherClass[]
  enrollments Enrollment[]
  lessons     Lesson[]
  exams       Exam[]
  resources   Resource[]
  metadata    Json?
  isDeleted   Boolean  @default(false)
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Enrollment {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  classId   String
  class     Class    @relation(fields: [classId], references: [id])
  enrolledAt DateTime @default(now())
  status    EnrollmentStatus @default(ACTIVE)
  metadata  Json?
  cancelledAt DateTime?
  @@unique([userId, classId])
}

enum EnrollmentStatus {
  ACTIVE
  PAUSED
  COMPLETED
  DROPPED
}

model TeacherClass {
  id         String   @id @default(cuid())
  teacherId  String
  teacher    User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  classId    String
  class      Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())
  isPrimary  Boolean  @default(true)
}

model Lesson {
  id                  String   @id @default(cuid())
  classId             String
  class               Class    @relation(fields: [classId], references: [id])
  createdBy           String
  title               String
  description         String?
  type                LessonType
  status              LessonStatus
  scheduledAt         DateTime?
  duration            Int?
  roomId              String?
  recordingEnabled    Boolean  @default(true)
  cloudinaryPublicId  String?
  cloudinaryUrl       String?
  cloudinaryThumbnail String?
  durationSeconds     Int?
  publishedAt         DateTime?
  isPublished         Boolean  @default(false)
  accessLevel         String?
  subject             String?
  tags                Json?
  contentType         String?
  contentBlocks       ContentBlock[]
  attendees           SessionAttendee[]
  progress            Progress[]
  session             LessonSession?
  chatMessages        ChatMessage[]
  activities          StudentActivity[]
  exercises           ClassExercise[]
  polls               LivePoll[]
  recordings          LessonRecording[]
  isDeleted           Boolean  @default(false)
  deletedAt           DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

enum LessonType {
  LIVE
  RECORDED
  HYBRID
}

enum LessonStatus {
  DRAFT
  SCHEDULED
  LIVE
  COMPLETED
  ARCHIVED
}

model ContentBlock {
  id        String @id @default(cuid())
  lessonId  String?
  lesson    Lesson? @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  type      String
  order     Int    @default(0)
  content   Json
  createdAt DateTime @default(now())
}

model SessionAttendee {
  id              String   @id @default(cuid())
  lessonId        String
  lesson          Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt        DateTime @default(now())
  leftAt          DateTime?
  durationSeconds Int      @default(0)
  attended        Boolean  @default(true)
  watchedRecording Boolean @default(false)
  sessionId       String?
  liveSession     LessonSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
}

model Progress {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId       String
  lesson         Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  watched        Boolean  @default(false)
  watchedAt      DateTime?
  percentageWatched Int   @default(0)
  lastWatchedAt  DateTime?
  notes          String?
  bookmarkedAt   DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@unique([userId, lessonId])
}

model Exam {
  id               String   @id @default(cuid())
  classId          String
  class            Class    @relation(fields: [classId], references: [id])
  title            String
  description      String?
  type             ExamType
  scheduledAt      DateTime?
  duration         Int
  totalMarks       Int      @default(100)
  passingMarks     Int      @default(50)
  questions        Question[]
  attempts         ExamAttempt[]
  isDeleted        Boolean  @default(false)
  deletedAt        DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

enum ExamType {
  QUIZ
  ASSIGNMENT
  PRACTICE
  MIDTERM
  FINAL
  DIAGNOSTIC
}

model Question {
  id            String   @id @default(cuid())
  examId        String
  exam          Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  type          QuestionType
  text          String
  marks         Int      @default(1)
  orderIndex    Int
  options       Json?
  correctAnswer Json?
  explanation   String?
  imageAssetId  String?
  imageAsset    MediaAsset? @relation("QuestionImageAsset", fields: [imageAssetId], references: [id])
  answers       Answer[]
  createdAt     DateTime @default(now())
}

enum QuestionType {
  MCQ
  MULTIPLE_SELECT
  ESSAY
  SHORT_ANSWER
  NUMERIC
  MATCHING
  DRAG_DROP
  FILL_BLANK
}

model ExamAttempt {
  id           String   @id @default(cuid())
  examId       String
  exam         Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  startedAt    DateTime @default(now())
  submittedAt  DateTime?
  score        Int?
  percentage   Int?
  isPassed     Boolean?
  feedback     String?
  flaggedForReview Boolean @default(false)
  suspiciousActivity String?
  answers      Answer[]
  createdAt    DateTime @default(now())
  @@unique([examId, userId])
}

model Answer {
  id          String   @id @default(cuid())
  attemptId   String
  attempt     ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId  String
  question    Question @relation(fields: [questionId], references: [id])
  answerText  String?
  selectedOption Json?
  numericAnswer Float?
  isCorrect   Boolean?
  earnedMarks Int?
  submittedAt DateTime @default(now())
}

model Resource {
  id               String   @id @default(cuid())
  classId          String
  class            Class    @relation(fields: [classId], references: [id])
  title            String
  description      String?
  type             ResourceType
  subject          String?
  status           ResourceStatus @default(READY)
  isPublished      Boolean  @default(true)
  publishedAt      DateTime?
  accessLevel      String
  mediaId          String?
  media            MediaAsset? @relation("ResourceMedia", fields: [mediaId], references: [id])
  fileSize         Int?
  authorId         String?
  author           User? @relation("UserResources", fields: [authorId], references: [id])
  year             Int?
  examBoard        String?
  tags             Json?
  downloadCount    Int      @default(0)
  isDeleted        Boolean  @default(false)
  deletedAt        DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

enum ResourceType {
  PDF_NOTE
  WORKSHEET
  PAST_PAPER
  SOLUTION_MANUAL
  FLASHCARD_SET
  VIDEO_TUTORIAL
  STUDY_GUIDE
}

enum ResourceStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
}

model Notification {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           NotificationType
  title          String
  body           String
  link           String?
  metadata       Json?
  read           Boolean  @default(false)
  readAt         DateTime?
  sentToEmail    Boolean  @default(false)
  sentToSms      Boolean  @default(false)
  sentToPush     Boolean  @default(false)
  channel        String?
  priority       Int      @default(0)
  createdAt      DateTime @default(now())
}

enum NotificationType {
  LESSON_STARTING
  HOMEWORK_DUE
  GRADE_PUBLISHED
  EXAM_SCORE
  ATTENDANCE_LOW
  PAYMENT_EXPIRING
  ANNOUNCEMENT
  MESSAGE
  ASSIGNMENT_FEEDBACK
  CATCH_UP_RECOMMENDED
}

model Communication {
  id         String   @id @default(cuid())
  senderId   String
  sender     User     @relation("SentMessages", fields: [senderId], references: [id])
  receiverId String
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id])
  type       CommunicationType
  subject    String?
  body       String
  attachmentMediaId String?
  attachmentMedia   MediaAsset? @relation("CommunicationAttachmentMedia", fields: [attachmentMediaId], references: [id])
  read       Boolean  @default(false)
  readAt     DateTime?
  parentId   String?
  parent     Communication? @relation("ThreadedMessages", fields: [parentId], references: [id], onDelete: Cascade)
  replies    Communication[] @relation("ThreadedMessages")
  createdAt  DateTime @default(now())
}

enum CommunicationType {
  DIRECT_MESSAGE
  ANNOUNCEMENT
  BROADCAST
}

model AdmissionForm {
  id                String   @id @default(cuid())
  studentName       String
  dateOfBirth       DateTime
  nationalId        String?
  gender            String?
  parentName        String
  parentEmail       String
  parentPhone       String
  parentOccupation  String?
  previousSchool    String?
  previousGrade     Int?
  applyingForGrade  Int
  preferredSubjects Json?
  documentsMediaIds String? // CSV of media ids or JSON
  consentSigned     Boolean  @default(false)
  status            AdmissionStatus @default(SUBMITTED)
  submittedAt       DateTime @default(now())
  reviewedAt        DateTime?
  reviewedBy        String?
  notes             String?
  enrolledStudentId String?
}

enum AdmissionStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  ENROLLED
}

model Attendance {
  id         String   @id @default(cuid())
  userId     String
  lessonId   String?
  classId    String?
  date       DateTime
  status     AttendanceStatus
  remarks    String?
  recordedAt DateTime @default(now())
  recordedBy String?
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
  ONLINE
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  oldValue  Json?
  newValue  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
}

model SystemMetric {
  id      String   @id @default(cuid())
  metric  String
  value   Float
  date    DateTime
  tags    Json?
  createdAt DateTime @default(now())
}

// Media and storage
model MediaAsset {
  id              String   @id @default(cuid())
  provider        StorageProvider @default(CLOUDINARY)
  providerId      String?  @unique
  originalUrl     String
  publicId        String?
  filename        String?
  mimeType        String?
  size            Int?
  width           Int?
  height          Int?
  thumbnails      Json?
  metadata        Json?
  uploadedById    String?
  uploadedBy      User?    @relation("MediaAssetUploader", fields: [uploadedById], references: [id])
  avatars         User[]   @relation("UserAvatar")
  questions       Question[] @relation("QuestionImageAsset")
  resources       Resource[] @relation("ResourceMedia")
  communicationAttachments Communication[] @relation("CommunicationAttachmentMedia")
  heroMediaArticles NewsArticle[] @relation("NewsArticleHeroMedia")
  isPrivate       Boolean  @default(false)
  isDeleted       Boolean  @default(false)
  deletedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum StorageProvider {
  CLOUDINARY
  S3
  LOCAL
}

// Content editing / revision history
model ContentRevision {
  id        String   @id @default(cuid())
  entity    String
  entityId  String
  data      Json
  authorId  String?
  author    User?    @relation("UserContentRevisions", fields: [authorId], references: [id])
  createdAt DateTime @default(now())
  note      String?
}

model NewsArticle {
  id          String @id @default(cuid())
  slug        String @unique
  title       String
  summary     String?
  content     Json
  authorId    String?
  author      User?  @relation("UserNewsArticles", fields: [authorId], references: [id])
  heroMediaId String?
  heroMedia   MediaAsset? @relation("NewsArticleHeroMedia", fields: [heroMediaId], references: [id])
  tags        Json?
  isPublished Boolean @default(false)
  publishedAt DateTime?
  isDeleted   Boolean  @default(false)
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Permissions & API keys
model Permission {
  id          String @id @default(cuid())
  name        String @unique
  description String?
  rolePermissions RolePermission[] @relation("PermissionRolePermissions")
}

model RolePermission {
  id          String @id @default(cuid())
  role        UserRole
  permissionId String
  permission   Permission @relation("PermissionRolePermissions", fields: [permissionId], references: [id], onDelete: Cascade)
}

model ApiKey {
  id         String @id @default(cuid())
  userId     String
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  keyHash    String
  scopes     Json?
  lastUsedAt DateTime?
  revoked    Boolean @default(false)
  createdAt  DateTime @default(now())
}

// Webhooks / integrations
model Webhook {
  id        String @id @default(cuid())
  url       String
  secret    String?
  events    Json
  enabled   Boolean @default(true)
  lastSent  DateTime?
  createdAt DateTime @default(now())
}

// Analytics / events
model EventTrack {
  id        String @id @default(cuid())
  userId    String?
  event     String
  payload   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
}

// Site / tenant settings
model SiteSetting {
  id      String @id @default(cuid())
  key     String @unique
  value   Json
  scope   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Misc helpers
model LessonSession {
  id              String   @id @default(cuid())
  lessonId        String   @unique
  lesson          Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  roomId          String   @unique
  streamKey       String?  // RTMP stream key for broadcasting
  status          LiveSessionStatus @default(PENDING)
  startedAt       DateTime?
  endedAt         DateTime?
  recordingUrl    String?
  recordingId     String?  // Cloudinary recording ID
  maxParticipants Int      @default(500)
  currentViewers  Int      @default(0)
  description     String?
  attendees       SessionAttendee[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum LiveSessionStatus {
  PENDING
  LIVE
  RECORDING
  COMPLETED
  ARCHIVED
}

model ChatMessage {
  id        String   @id @default(cuid())
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String
  isSystem  Boolean  @default(false)
  reactions Json?    // For emoji reactions
  pinnedAt  DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lessonId])
  @@index([userId])
}

model StudentActivity {
  id         String   @id @default(cuid())
  lessonId   String
  lesson     Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action     ActivityType
  metadata   Json?    // Additional data like raised hand timestamp, poll response, etc
  createdAt  DateTime @default(now())

  @@index([lessonId])
  @@index([userId])
}

enum ActivityType {
  JOINED
  RAISED_HAND
  LOWERED_HAND
  ANSWERED_POLL
  SHARED_SCREEN
  SHARED_CHAT
  PARTICIPATED
  LEFT
}

// In-class exercises and live questions
model ClassExercise {
  id              String   @id @default(cuid())
  lessonId        String
  lesson          Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  createdBy       String
  createdByUser   User     @relation("ExerciseCreator", fields: [createdBy], references: [id])
  title           String
  description     String?
  type            String   @default("ASSIGNMENT") // ASSIGNMENT, QUIZ, DISCUSSION, CODE_CHALLENGE
  timeLimit       Int?     // in seconds
  isPublished     Boolean  @default(true)
  questions       ClassExerciseQuestion[]
  responses       ClassExerciseResponse[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([lessonId])
  @@index([createdBy])
}

model ClassExerciseQuestion {
  id               String   @id @default(cuid())
  exerciseId       String
  exercise         ClassExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  order            Int
  type             String   @default("MCQ") // MCQ, SHORT_ANSWER, ESSAY, CODE
  text             String
  options          Json?    // for MCQ: [{ id, text }, ...]
  correctAnswer    Json?
  explanation      String?
  points           Int      @default(1)
  createdAt        DateTime @default(now())

  @@index([exerciseId])
}

model ClassExerciseResponse {
  id                String   @id @default(cuid())
  exerciseId        String
  exercise          ClassExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  userId            String
  user              User     @relation("ExerciseResponses", fields: [userId], references: [id])
  answers           Json?    // { questionId: answer }
  submittedAt       DateTime @default(now())
  score             Int?
  feedback          String?
  isCorrect         Boolean?
  createdAt         DateTime @default(now())

  @@unique([exerciseId, userId])
  @@index([exerciseId])
  @@index([userId])
}

// Live polls for real-time feedback
model LivePoll {
  id              String   @id @default(cuid())
  lessonId        String
  lesson          Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  createdBy       String
  createdByUser   User     @relation("PollCreator", fields: [createdBy], references: [id])
  question        String
  type            String   @default("SINGLE_CHOICE") // SINGLE_CHOICE, MULTIPLE_CHOICE, OPEN_ENDED
  options         Json?    // [{ id, text }, ...]
  isActive        Boolean  @default(true)
  startedAt       DateTime @default(now())
  endedAt         DateTime?
  responses       LivePollResponse[]
  createdAt       DateTime @default(now())

  @@index([lessonId])
  @@index([createdBy])
}

model LivePollResponse {
  id            String   @id @default(cuid())
  pollId        String
  poll          LivePoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation("PollResponses", fields: [userId], references: [id])
  selectedOption Json?    // { optionId } or { text } for open-ended
  respondedAt   DateTime @default(now())

  @@unique([pollId, userId])
  @@index([pollId])
  @@index([userId])
}

// Recording metadata and storage
model LessonRecording {
  id                String   @id @default(cuid())
  lessonId          String
  lesson            Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  recordingId       String   @unique
  storagePath       String   // S3, Cloudinary, or file path
  duration          Int?     // in seconds
  fileSize          Int?
  transcriptUrl     String?
  thumbnailUrl      String?
  metadata          Json?
  isPublished       Boolean  @default(true)
  accessLevel       String   @default("ENROLLED") // PUBLIC, ENROLLED, PRIVATE
  createdAt         DateTime @default(now())

  @@index([lessonId])
}

model RateLimit {
  id        String @id @default(cuid())
  key       String
  limit     Int
  windowSec Int
  remaining Int
  resetAt   DateTime
}

// Indexes and views can be added later; keep schema flexible for migrations.

